{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/treasury-report",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/books-sync",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/LedgerLouisePrivacyPolicy.pdf", "destination": "/policies/LedgerLouisePrivacyPolicy.pdf" },
    { "source": "/LedgerLouiseDataRetentionAndDisposalPolicy.pdf", "destination": "/policies/LedgerLouiseDataRetentionAndDisposalPolicy.pdf" },
    { "source": "/LedgerLouiseInformationSecurityPolicy.pdf", "destination": "/policies/LedgerLouiseInformationSecurityPolicy.pdf" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
