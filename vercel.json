{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "framework": null,
  "functions": {
    "api/documents/profile.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/documents/verify.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/brand.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/game-assets.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "api/cron/game-assets.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "api/cron/state-records.ts": {
      "memory": 256,
      "maxDuration": 300
    },
    "api/ask.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "api/palm-sync.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "api/plaid/history.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "api/stable.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/csp-report.ts": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/**/*.ts": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/treasury-report",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/books-sync",
      "schedule": "0 12-15 * * *"
    },
    {
      "path": "/api/stable?cron=1",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/state-records",
      "schedule": "40 21 * * *"
    },
    {
      "path": "/api/plaid/history",
      "schedule": "17 13 * * 1"
    },
    {
      "path": "/api/cron/game-assets",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "burtonfamilyoffice.com"
        }
      ],
      "destination": "https://www.burtonfamilyoffice.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/LedgerLouisePrivacyPolicy.pdf",
      "destination": "/policies/LedgerLouisePrivacyPolicy.pdf"
    },
    {
      "source": "/LedgerLouiseDataRetentionAndDisposalPolicy.pdf",
      "destination": "/policies/LedgerLouiseDataRetentionAndDisposalPolicy.pdf"
    },
    {
      "source": "/LedgerLouiseInformationSecurityPolicy.pdf",
      "destination": "/policies/LedgerLouiseInformationSecurityPolicy.pdf"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://cdn.plaid.com\"), microphone=(self), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self' script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://ajax.googleapis.com https://cdn.plaid.com https://www.youtube.com https://s.ytimg.com style-src 'self' 'unsafe-inline' https://fonts.googleapis.com font-src 'self' data: https://fonts.gstatic.com img-src 'self' data: blob: https://*.supabase.co https://www.google.com https://cdn.plaid.com https://www.gstatic.com https://i.ytimg.com media-src 'self' blob: https://*.supabase.co connect-src 'self' https://*.supabase.co https://api.openai.com wss://api.openai.com https://cdn.plaid.com https://cdnjs.cloudflare.com https://ajax.googleapis.com https://www.gstatic.com worker-src 'self' blob: https://cdnjs.cloudflare.com frame-src 'self' blob: https://cdn.plaid.com https://*.supabase.co https://www.youtube.com https://www.youtube-nocookie.com frame-ancestors 'self' object-src 'none' base-uri 'self' form-action 'self' report-uri /api/csp-report"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
