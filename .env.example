# Copy to .env for `vercel dev`. Every variable is described in README.md
# ("Environment"). Nothing here is a real value.

# Supabase (every read and write)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
# scripts/migrate.mjs only (applying migrations): a personal access token and the project ref.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Sign-in and email (Bird)
BIRD_ACCESS_KEY=
BIRD_WORKSPACE_ID=
BIRD_SMS_CHANNEL_ID=
BIRD_EMAIL_CHANNEL_ID=
BIRD_SMS_FROM=
BIRD_EMAIL_FROM=
BIRD_EMAIL_REPLY_TO=
BIRD_WEBHOOK_SECRET=
AUTH_SECRET=   # required: pepper for sign-in codes (any long random string)
SIGNIN_COUNTRY_CODES=+1
SIGNIN_HOURLY_CAP=60
MAIL_DOMAIN=burtonfamilyoffice.com
MAIL_IMAGE_SECRET=   # signs mail image links (any long random string)

# Banking
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=
MERCURY_API_TOKEN=
REPORT_ACTIVITY_MASK=1886,1116

# Crons (Vercel sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Registered agent and state records (Palm)
PALM_API_KEY=sk_test_
PALM_WEBHOOK_SECRET=

# Paper mail (Stable)
STABLE_API_KEY=
STABLE_WEBHOOK_TOKEN=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MESHY_API_KEY=

# iPhone app push
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=com.burtonfamilyoffice.app

SITE_URL=https://www.burtonfamilyoffice.com
